# ========================================================================
# PONDOK PESANTREN KEBON KELAPA AL-MA'RIFAH
# Sistem Pembayaran Syariah - Environment Configuration Template
# ========================================================================

# 1. SUPABASE (PostgreSQL, Auth & Storage)
# Salin konfigurasi ini ke file .env.local untuk menghubungkan ke Supabase Anda.
# Aplikasi ini dapat berjalan langsung dalam mode demo lokal jika kredensial belum diisi.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (HANYA digunakan di sisi backend/server, JANGAN PERNAH diekspos ke frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. KONFIGURASI APLIKASI
NEXT_PUBLIC_APP_NAME="Sistem Pembayaran Syariah PP Kebon Kelapa Al-Ma'rifah"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. PAYMENT GATEWAY (OPSIONAL / TAHAP LANJUTAN)
# Biarkan kosong jika menggunakan metode transfer manual & verifikasi kasir bendahara
PAYMENT_GATEWAY_ENVIRONMENT=sandbox
PAYMENT_GATEWAY_SERVER_KEY=
PAYMENT_GATEWAY_CLIENT_KEY=
# Webhook: HMAC_SHA256(secret, timestamp + "." + rawBody)
# Header: X-Gateway-Signature, X-Gateway-Timestamp
PAYMENT_GATEWAY_WEBHOOK_SECRET=
# HANYA untuk simulasi lokal. Jangan aktifkan di production.
# ALLOW_DEMO_PAYMENT_SIMULATION=true

# 4. WHATSAPP & EMAIL NOTIFICATION GATEWAY (OPSIONAL)
# Disiapkan untuk integrasi Fonnte / Wablas / Twilio
WA_GATEWAY_API_URL=
WA_GATEWAY_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 5. CHATBOT & AI (OPSIONAL / TAHAP LANJUTAN)
# Chatbot berfungsi penuh TANPA AI via FAQ + backend tools lokal.
# Jika suatu hari memakai AI eksternal, isi kunci HANYA di server (jangan
# pernah menaruhnya di kode frontend atau NEXT_PUBLIC_*).
# AI tidak menerima data pribadi santri/transaksi tanpa perlindungan.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Base URL penyedia yang kompatibel OpenAI. Contoh:
# OpenAI     https://api.openai.com/v1
# DeepSeek   https://api.deepseek.com/v1
# Groq       https://api.groq.com/openai/v1
# OpenRouter https://openrouter.ai/api/v1
# Gemini     https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.openai.com/v1
# Batas permintaan chatbot backend per IP per menit
CHATBOT_MAX_PER_MIN=20

# 6. NOTIFIKASI TELEGRAM (SERVER ONLY)
# Buat bot lewat @BotFather, lalu salin tokennya ke sini.
# JANGAN memakai prefix NEXT_PUBLIC_ agar token tidak bocor ke browser.
TELEGRAM_BOT_TOKEN=
# Username bot TANPA @, dipakai untuk deep link /start <kode> wali.
TELEGRAM_BOT_USERNAME=
# Secret header X-Telegram-Bot-Api-Secret-Token untuk /api/telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=
# HANYA untuk development lokal bila webhook secret belum tersedia.
# ALLOW_TELEGRAM_WEBHOOK_WITHOUT_SECRET=true
# ID chat/grup tujuan notifikasi admin umum. Grup diawali minus, mis. -1001234567890.
TELEGRAM_CHAT_ID=
# Set false untuk mematikan notifikasi tanpa menghapus konfigurasi.
TELEGRAM_NOTIFY_ENABLED=true
# Batas notifikasi keluar per menit (anti-spam).
TELEGRAM_MAX_PER_MINUTE=30
# Batas waktu request ke Telegram API (ms).
TELEGRAM_TIMEOUT_MS=10000
# Opsional: kunci untuk endpoint tes /api/telegram/test.
# Jika diisi, header x-telegram-test-secret wajib dikirim. Jika kosong,
# endpoint tes hanya aktif saat development.
TELEGRAM_TEST_SECRET=

# 7. KUITANSI & RUNTIME DEMO (SERVER ONLY)
# HMAC untuk tautan unduh kuitansi berbatas waktu (30 menit). Wajib diisi di production.
RECEIPT_LINK_SECRET=
# Lokasi penyimpanan JSON/PDF runtime. Default: <project>/data/runtime
# ALMARIFAH_DATA_DIR=C:\path\ke\data\runtime

